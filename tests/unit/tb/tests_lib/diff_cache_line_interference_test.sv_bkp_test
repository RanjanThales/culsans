`include "uvm_macros.svh" 
import uvm_pkg::*; 
import ariane_pkg::*; 
import snoop_test::*; 
import ace_test::*; 
import tb_ace_ccu_pkg::*; 
import tb_std_cache_subsystem_pkg::*; 
import tb_pkg::*;


class diff_cache_line_interference_test extends culsans_base_test;
  `uvm_component_utils(diff_cache_line_interference_test)
   

 write1_seq              w1_seq;
 write2_seq              w2_seq;
scnerio2_write1_seq      s2_w1seq;
scnerio2_write2_seq      s2_w2seq;
scnerio2_read_seq        s2_rseq;
scnerio2_read2_seq       s2_r2seq;

  function new(string name = "diff_cache_line_interference_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    
    w1_seq = write1_seq::type_id::create("w1_seq");
    w2_seq = write2_seq::type_id::create("w2_seq");
    s2_w1seq = scnerio2_write1_seq::type_id::create("s2_w1seq");
    s2_w2seq = scnerio2_write2_seq::type_id::create("s2_w2seq");
    s2_rseq = scnerio2_read_seq::type_id::create("s2_rseq");
    s2_r2seq = scnerio2_read2_seq::type_id::create("s2_r2seq");

  endfunction

  task run_phase(uvm_phase phase);
    phase.raise_objection(this);

    `uvm_info("TESTNAME", $sformatf("Inside diff_cache_line_interference_test: testname = %s", testname), UVM_LOW)

    // Wait for reset deassertion
    do begin
      @(posedge clk_rst_if.clk);
    end while (clk_rst_if.rst_n == 1'b0);

    c_env_h.start_monitors();

    repeat (1800) begin @(posedge clk_rst_if.clk);  end

    test_header("diff_cache_line_interference", "8 consecutive read misses in the same cache set");

    // Sequences
    fork
      s2_w1seq.start(c_env_h.d_agt[0].d_seqr[0][0]);  //core0 writing into two different cache lines
      s2_w2seq.start(c_env_h.d_agt[0].d_seqr[0][1]);  //core0 writing into two different cache lines
    join

    #2000;

    fork
      s2_rseq.start(c_env_h.d_agt[1].d_seqr[1][0]);
      s2_r2seq.start(c_env_h.d_agt[2].d_seqr[2][0]);

   join_any

    
      w1_seq.start(c_env_h.d_agt[0].d_seqr[0][0]);
      w2_seq.start(c_env_h.d_agt[3].d_seqr[3][2]);



    repeat(600) @(posedge clk_rst_if.clk);

    $display("Test done");
    $display("------------------------------------------------------------------");
    for (int c = 0; c < c_env_cfg.N_C; c++) begin
      for (int p = 0; p < 3; p++) begin
        c_env_h.dcache_mon[c][p].print_stats();
      end
    end
    $display("------------------------------------------------------------------");

    $finish();
    phase.drop_objection(this);
  endtask

endclass


